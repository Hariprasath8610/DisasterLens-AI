# DisasterLens AI Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI Service & Local Ollama Configuration
AI_SERVICE_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120.0
OLLAMA_NUM_PREDICT=450

# Backend-only Weather, Alert, and AI Integrations
WINDY_API_KEY=your_windy_api_key_here
WINDY_TIMEOUT_SECONDS=10
HIGH_RISK_THRESHOLD=80
SMS_DEMO_MODE=true
SMS_COOLDOWN_MINUTES=60
OPENWEATHER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
