# DisasterLens AI Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI Service & Local Ollama Configuration
AI_SERVICE_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120.0
OLLAMA_NUM_PREDICT=450

# Backend-only Weather, Alert, and AI Integrations
WINDY_API_KEY=your_windy_api_key_here
WINDY_TIMEOUT_SECONDS=10
ALERT_MODE=demo
ALERT_THRESHOLD=80
ALERT_COOLDOWN_SECONDS=300
HIGH_RISK_THRESHOLD=80

# Twilio Official SMS Alert Configuration
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_number
TWILIO_FROM_NUMBER=your_twilio_number
ALERT_RECIPIENT_PHONE=your_authorized_demo_phone
DEMO_SMS_RECIPIENT=your_authorized_demo_phone
SMS_COOLDOWN_MINUTES=5
SMS_WEBHOOK_URL=

OPENWEATHER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
